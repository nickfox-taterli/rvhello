// RV32I 第 6 阶段程序: Load/Store (byte/halfword/word), 末尾 ECALL 触发 trap @ PC=0x48.
// 数据基址 x10 = 0x100, 程序不到 64 字, 不冲突.
// 验证: SW/LW 往返; 各字节通道 LB/LBU (正字节); SB 存 0x80 后 LB(符号)/LBU(零扩展);
//       SH 存 0xFFFF 后 LH(符号)/LHU(零扩展).
// 0x00: addi x10,x0,0x100   -> x10 = 0x100
// 0x04: lui  x11,0x12345    -> x11 = 0x12345000
// 0x08: addi x11,x11,0x678  -> x11 = 0x12345678
// 0x0C: sw   x11,0(x10)     -> mem[0x100] = 0x12345678
// 0x10: lw   x12,0(x10)     -> x12 = 0x12345678
// 0x14: lb   x13,0(x10)     -> x13 = 0x00000078 (byte0)
// 0x18: lbu  x14,0(x10)     -> x14 = 0x00000078
// 0x1C: lb   x15,1(x10)     -> x15 = 0x00000056 (byte1)
// 0x20: lb   x16,2(x10)     -> x16 = 0x00000034 (byte2)
// 0x24: lb   x17,3(x10)     -> x17 = 0x00000012 (byte3)
// 0x28: addi x18,x0,-128    -> x18 = 0xFFFFFF80
// 0x2C: sb   x18,4(x10)     -> mem[0x104] byte0 = 0x80
// 0x30: lb   x19,4(x10)     -> x19 = 0xFFFFFF80 (符号扩展)
// 0x34: lbu  x20,4(x10)     -> x20 = 0x00000080 (零扩展)
// 0x38: addi x21,x0,-1      -> x21 = 0xFFFFFFFF
// 0x3C: sh   x21,8(x10)     -> mem[0x108] half0 = 0xFFFF
// 0x40: lh   x22,8(x10)     -> x22 = 0xFFFFFFFF (符号扩展)
// 0x44: lhu  x23,8(x10)     -> x23 = 0x0000FFFF (零扩展)
// 0x48: ECALL (第 6 阶段非法) -> trap @ PC = 0x48
