// RV32I 第 2 阶段程序: 基础 ALU 与比较 (I 型 + R 型), 末尾 ECALL 触发 trap @ PC=0x38.
// 0x00: addi  x1, x0, 7      -> x1  = 0x00000007
// 0x04: addi  x2, x0, -3     -> x2  = 0xFFFFFFFD  (imm=0xFFD)
// 0x08: add   x3, x1, x2     -> x3  = 0x00000004
// 0x0C: sub   x4, x1, x2     -> x4  = 0x0000000A
// 0x10: slt   x5, x2, x1     -> x5  = 0x00000001
// 0x14: sltu  x6, x2, x1     -> x6  = 0x00000000
// 0x18: xor   x7, x1, x2     -> x7  = 0xFFFFFFFA
// 0x1C: or    x8, x1, x2     -> x8  = 0xFFFFFFFF
// 0x20: and   x9, x1, x2     -> x9  = 0x00000005
// 0x24: slti  x10, x1, 10    -> x10 = 0x00000001
// 0x28: sltiu x11, x2, 0     -> x11 = 0x00000000
// 0x2C: xori  x12, x1, 3     -> x12 = 0x00000004
// 0x30: ori   x13, x1, 0x80  -> x13 = 0x00000087
// 0x34: andi  x14, x1, 0x0F  -> x14 = 0x00000007
// 0x38: ECALL (第 2 阶段非法) -> trap @ PC = 0x38
