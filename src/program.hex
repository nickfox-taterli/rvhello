// RV32I 第 3 阶段程序: 移位 (立即数 + 寄存器), 末尾 ECALL 触发 trap @ PC=0x24.
// 0x00: addi x1, x0, 1      -> x1 = 0x00000001
// 0x04: slli x2, x1, 4      -> x2 = 0x00000010   (1 << 4)
// 0x08: addi x3, x0, -16    -> x3 = 0xFFFFFFF0
// 0x0C: srai x4, x3, 2      -> x4 = 0xFFFFFFFC   (-16 >>> 2 = -4, 算术)
// 0x10: srli x5, x3, 28     -> x5 = 0x0000000F   (0xFFFFFFF0 >> 28, 逻辑)
// 0x14: addi x6, x0, 2      -> x6 = 0x00000002   (移位量)
// 0x18: sll  x7, x2, x6     -> x7 = 0x00000040   (16 << 2)
// 0x1C: sra  x8, x3, x6     -> x8 = 0xFFFFFFFC   (-16 >>> 2 = -4, 算术)
// 0x20: srl  x9, x3, x6     -> x9 = 0x3FFFFFFC   (0xFFFFFFF0 >> 2, 逻辑)
// 0x24: ECALL (第 3 阶段非法) -> trap @ PC = 0x24
00100093
00409113
FF000193
4021D213
01C1D293
00200313
006113B3
